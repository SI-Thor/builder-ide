      "proposal": {
        "code": "const LOG = 'jungle_log';\nconst T = { x: 16, y: 69, z: -31 };\nconst C = { x: T.x + 0.5, y: T.y + 0.5, z: T.z + 0.5 };\n\nfunction count() {\n  const r = mc.count(LOG);\n  return r && typeof r.count === 'number' ? r.count : 0;\n}\n\nfunction mineOnce(reach) {\n  mc.look_at(C.x, C.y, C.z);\n  mc.sleep(150);\n  const m = mc.mine_block(LOG, reach, 1);\n  console.log('mine: ' + JSON.stringify(m));\n  mc.sleep(350);\n  const c = mc.collect(LOG, 1, reach);\n  console.log('collect: ' + JSON.stringify(c));\n  mc.sleep(150);\n}\n\nconsole.log('start ' + LOG + ': ' + count());\n\nif (count() === 0) {\n  const mv = mc.move_to_block(LOG, 32, 60000);\n  console.log('move_to_block: ' + JSON.stringify(mv));\n  mineOnce(8);\n}\n\nif (count() === 0) {\n  const spots = [\n    { x: T.x + 1.5, y: T.y, z: T.z + 0.5 },\n    { x: T.x - 1.5, y: T.y, z: T.z + 0.5 },\n    { x: T.x + 0.5, y: T.y, z: T.z + 1.5 },\n    { x: T.x + 0.5, y: T.y, z: T.z - 1.5 },\n    { x: T.x + 1.5, y: T.y + 1, z: T.z + 0.5 },\n    { x: T.x - 1.5, y: T.y + 1, z: T.z + 0.5 },\n    { x: T.x + 0.5, y: T.y + 1, z: T.z + 1.5 },\n    { x: T.x + 0.5, y: T.y + 1, z: T.z - 1.5 }\n  ];\n  for (const s of spots) {\n    if (count() > 0) break;\n    const mv = mc.move_to(s.x, s.y, s.z, 30000);\n    console.log('move_to: ' + JSON.stringify(mv));\n    mineOnce(6);\n  }\n}\n\nif (count() === 0) {\n  const mv = mc.move_to(T.x + 0.5, T.y + 1, T.z + 0.5, 30000);\n  console.log('move_to above: ' + JSON.stringify(mv));\n  mineOnce(6);\n}\n\nif (count() === 0) {\n  mc.look_at(C.x, C.y, C.z);\n  mc.sleep(200);\n  const m = mc.mine_block(LOG, 64, 1);\n  console.log('long mine: ' + JSON.stringify(m));\n  mc.sleep(400);\n  const c = mc.collect(LOG, 1, 64);\n  console.log('long collect: ' + JSON.stringify(c));\n}\n\nconst finalCount = count();\nconsole.log('final ' + LOG + ': ' + finalCount);\nif (finalCount === 0) {\n  throw new Error('failed to collect ' + LOG);\n}",
