        "code": "const LOG = 'jungle_log';\nconst TARGET = { x: 16, y: 69, z: -31 };\nconst CENTER = { x: TARGET.x + 0.5, y: TARGET.y + 0.5, z: TARGET.z + 0.5 };\n\nfunction countLog() {\n  const r = mc.count(LOG);\n  return r && typeof r.count === 'number' ? r.count : 0;\n}\n\nfunction tryMine(reach) {\n  mc.look_at(CENTER.x, CENTER.y, CENTER.z);\n  mc.sleep(250);\n  const m = mc.mine_block(LOG, reach, 1);\n  console.log('mine: ' + JSON.stringify(m));\n  mc.sleep(500);\n  const c = mc.collect(LOG, 1, reach);\n  console.log('collect: ' + JSON.stringify(c));\n  mc.sleep(250);\n}\n\nconsole.log('start ' + LOG + ': ' + countLog());\n\nif (countLog() === 0) {\n  const mv = mc.move_to_block(LOG, 64, 60000);\n  console.log('move_to_block: ' + JSON.stringify(mv));\n  tryMine(16);\n}\n\nif (countLog() === 0) {\n  const spots = [\n    { x: TARGET.x + 0.5, y: TARGET.y + 0.5, z: TARGET.z + 0.5 },\n    { x: TARGET.x - 0.5, y: TARGET.y + 0.5, z: TARGET.z + 0.5 },\n    { x: TARGET.x + 0.5, y: TARGET.y + 0.5, z: TARGET.z - 0.5 },\n    { x: TARGET.x - 0.5, y: TARGET.y + 0.5, z: TARGET.z - 0.5 },\n    { x: TARGET.x + 0.5, y: TARGET.y + 1.5, z: TARGET.z + 0.5 },\n    { x: TARGET.x - 0.5, y: TARGET.y + 1.5, z: TARGET.z + 0.5 },\n    { x: TARGET.x + 0.5, y: TARGET.y + 1.5, z: TARGET.z - 0.5 },\n    { x: TARGET.x - 0.5, y: TARGET.y + 1.5, z: TARGET.z - 0.5 }\n  ];\n  for (const s of spots) {\n    if (countLog() > 0) break;\n    const mv = mc.move_to(s.x, s.y, s.z, 30000);\n    console.log('move_to: ' + JSON.stringify(mv));\n    tryMine(16);\n  }\n}\n\nif (countLog() === 0) {\n  mc.look_at(CENTER.x, CENTER.y, CENTER.z);\n  mc.sleep(300);\n  const m = mc.mine_block(LOG, 64, 1);\n  console.log('long mine: ' + JSON.stringify(m));\n  mc.sleep(700);\n  const c = mc.collect(LOG, 1, 64);\n  console.log('long collect: ' + JSON.stringify(c));\n}\n\nconst finalCount = countLog();\nconsole.log('final ' + LOG + ': ' + finalCount);\nif (finalCount === 0) {\n  throw new Error('failed to collect ' + LOG);\n}\n",
