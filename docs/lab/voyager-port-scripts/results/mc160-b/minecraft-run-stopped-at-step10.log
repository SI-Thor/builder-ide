        "code": "const LOG_BLOCK = 'jungle_log';\nconst LOG_ITEM = 'jungle_log';\nconst TARGET = { x: 8, y: 74, z: -44 };\n\nfunction logCount() {\n  const c = mc.count(LOG_ITEM);\n  return c && typeof c.count === 'number' ? c.count : 0;\n}\n\nfunction tryMineAndCollect() {\n  mc.look_at(TARGET.x, TARGET.y, TARGET.z);\n  mc.sleep(250);\n  const mined = mc.mine_block(LOG_BLOCK, 16, 1);\n  console.log('mine_block: ' + JSON.stringify(mined));\n  mc.sleep(500);\n  const collected = mc.collect(LOG_ITEM, 1, 16);\n  console.log('collect: ' + JSON.stringify(collected));\n  return logCount();\n}\n\nlet logs = logCount();\nconsole.log('initial jungle_log count: ' + logs);\n\nif (logs < 1) {\n  const moved = mc.move_to_block(LOG_BLOCK, 16, 30000);\n  console.log('move_to_block: ' + JSON.stringify(moved));\n  logs = tryMineAndCollect();\n}\n\nif (logs < 1) {\n  const spots = [\n    [8, 75, -44],\n    [7, 74, -44],\n    [9, 74, -44],\n    [8, 74, -43],\n    [8, 74, -45],\n    [8, 73, -44]\n  ];\n  for (const spot of spots) {\n    if (logs >= 1) break;\n    const moved = mc.move_to(spot[0], spot[1], spot[2], 15000);\n    console.log('move_to ' + spot.join(',') + ': ' + JSON.stringify(moved));\n    logs = tryMineAndCollect();\n  }\n}\n\nconsole.log('final jungle_log count: ' + logs);",
