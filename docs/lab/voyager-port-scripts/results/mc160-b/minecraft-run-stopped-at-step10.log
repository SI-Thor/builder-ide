        "code": "const target = { x: 8, y: 70, z: -44 };\n\nfunction logCount(item) {\n  const r = mc.count(item);\n  if (typeof r === 'number') return r;\n  if (r && typeof r.count === 'number') return r.count;\n  if (r && typeof r.have === 'number') return r.have;\n  return 0;\n}\n\nfunction hasLog() {\n  return logCount('jungle_log') > 0;\n}\n\nlet moved = mc.move_to_block('jungle_log', 16, 30000);\nconsole.log('move_to_block: ' + JSON.stringify(moved));\n\nlet bx = target.x;\nlet by = target.y;\nlet bz = target.z;\nif (moved && moved.block && typeof moved.block.x === 'number') {\n  bx = moved.block.x;\n  by = moved.block.y;\n  bz = moved.block.z;\n}\n\nmc.look_at(bx, by, bz);\n\nlet mined = mc.mine_block('jungle_log', 16, 1);\nconsole.log('mine_block: ' + JSON.stringify(mined));\n\nmc.sleep(500);\n\nlet collected = mc.collect('jungle_log', 1, 16);\nconsole.log('collect: ' + JSON.stringify(collected));\n\nif (!hasLog()) {\n  moved = mc.move_to(bx, by, bz, 30000);\n  console.log('move_to: ' + JSON.stringify(moved));\n  mc.look_at(bx, by, bz);\n  mined = mc.mine_block('jungle_log', 16, 1);\n  console.log('retry mine_block: ' + JSON.stringify(mined));\n  mc.sleep(500);\n  collected = mc.collect('jungle_log', 1, 16);\n  console.log('retry collect: ' + JSON.stringify(collected));\n}\n\nconsole.log('jungle_log count: ' + logCount('jungle_log'));",
