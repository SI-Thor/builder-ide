      ],
      "proposal": {
        "code": "const LOG = 'jungle_log';\nconst TARGET = { x: 11, y: 67, z: -35 };\n\nfunction logs() {\n  const r = mc.count(LOG);\n  return r && typeof r.count === 'number' ? r.count : 0;\n}\n\nfunction tryBreakAndCollect() {\n  mc.look_at(TARGET.x + 0.5, TARGET.y + 0.5, TARGET.z + 0.5);\n  mc.sleep(200);\n\n  let mined = 0;\n  for (let i = 0; i < 12 && mined < 1; i++) {\n    const m = mc.mine_block(LOG, 16, 1);\n    console.log('mine: ' + JSON.stringify(m));\n    if (m && typeof m.mined === 'number') mined += m.mined;\n    mc.sleep(250);\n  }\n\n  let collected = 0;\n  for (let i = 0; i < 12 && collected < 1; i++) {\n    const c = mc.collect(LOG, 1, 16);\n    console.log('collect: ' + JSON.stringify(c));\n    if (c && typeof c.collected === 'number') collected += c.collected;\n    mc.sleep(250);\n  }\n\n  return logs();\n}\n\nlet have = logs();\nconsole.log('start ' + LOG + ': ' + have);\n\nif (have < 1) {\n  const m = mc.move_to_block(LOG, 32, 20000);\n  console.log('move_to_block: ' + JSON.stringify(m));\n  have = tryBreakAndCollect();\n}\n\nif (have < 1) {\n  const spots = [\n    [10, 67, -35],\n    [12, 67, -35],\n    [11, 67, -34],\n    [11, 67, -36],\n    [10, 66, -35],\n    [12, 66, -35],\n    [11, 66, -34],\n    [11, 66, -36]\n  ];\n\n  for (const s of spots) {\n    if (have >= 1) break;\n    const m = mc.move_to(s[0], s[1], s[2], 10000);\n    console.log('move_to ' + s.join(',') + ': ' + JSON.stringify(m));\n    have = tryBreakAndCollect();\n  }\n}\n\nconsole.log('final ' + LOG + ': ' + have);",
        "description": "Move to the nearby jungle_log, break it, and collect the dropped log.",
