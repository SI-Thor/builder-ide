      "proposal": {
        "code": "const ITEM = 'oak_log';\nconst TARGET = { x: 2, y: 71, z: -39 };\n\nfunction logs() {\n  const r = mc.count(ITEM);\n  return r && typeof r.count === 'number' ? r.count : 0;\n}\n\nfunction tryMineCollect(maxDistance, mineTries, collectTries) {\n  mc.look_at(TARGET.x + 0.5, TARGET.y + 0.5, TARGET.z + 0.5);\n  mc.sleep(200);\n\n  for (let i = 0; i < mineTries && logs() < 1; i++) {\n    const m = mc.mine_block(ITEM, maxDistance, 1);\n    console.log('mine: ' + JSON.stringify(m));\n    mc.sleep(300);\n  }\n\n  for (let i = 0; i < collectTries && logs() < 1; i++) {\n    const c = mc.collect(ITEM, 1, maxDistance);\n    console.log('collect: ' + JSON.stringify(c));\n    mc.sleep(250);\n  }\n\n  return logs();\n}\n\nlet n = logs();\nconsole.log('start ' + ITEM + ': ' + n);\n\nif (n < 1) {\n  n = tryMineCollect(64, 3, 3);\n}\n\nif (n < 1) {\n  const mv = mc.move_to_block(ITEM, 64, 300000);\n  console.log('move_to_block: ' + JSON.stringify(mv));\n  n = tryMineCollect(64, 12, 12);\n}\n\nif (n < 1) {\n  const mv = mc.move_to(TARGET.x + 0.5, TARGET.y + 0.5, TARGET.z + 0.5, 300000);\n  console.log('move_to: ' + JSON.stringify(mv));\n  n = tryMineCollect(64, 16, 16);\n}\n\nif (n < 1) {\n  const spots = [\n    [3, 71, -39],\n    [1, 71, -39],\n    [2, 71, -38],\n    [2, 71, -40],\n    [3, 71, -38],\n    [1, 71, -38],\n    [3, 71, -40],\n    [1, 71, -40]\n  ];\n\n  for (const s of spots) {\n    if (n >= 1) break;\n    const mv = mc.move_to(s[0] + 0.5, s[1] + 0.5, s[2] + 0.5, 120000);\n    console.log('move_to ' + s.join(',') + ': ' + JSON.stringify(mv));\n    n = tryMineCollect(64, 10, 10);\n  }\n}\n\nconsole.log('final ' + ITEM + ': ' + n);",
