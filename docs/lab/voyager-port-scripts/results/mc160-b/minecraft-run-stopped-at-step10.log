        "code": "const ITEM = 'jungle_log';\nconst BLOCK = 'jungle_log';\nconst TARGET = { x: 5, y: 67, z: -37 };\n\nfunction countLogs() {\n  const r = mc.count(ITEM);\n  return r && typeof r.count === 'number' ? r.count : 0;\n}\n\nfunction attemptMine() {\n  mc.look_at(TARGET.x, TARGET.y, TARGET.z);\n  mc.sleep(250);\n  const mined = mc.mine_block(BLOCK, 32, 1);\n  console.log('mine_block: ' + JSON.stringify(mined));\n  mc.sleep(500);\n  const collected = mc.collect(ITEM, 1, 32);\n  console.log('collect: ' + JSON.stringify(collected));\n  return countLogs();\n}\n\nlet logs = countLogs();\nconsole.log('initial ' + ITEM + ' count: ' + logs);\n\nif (logs < 1) {\n  const moved = mc.move_to_block(BLOCK, 32, 30000);\n  console.log('move_to_block: ' + JSON.stringify(moved));\n  logs = attemptMine();\n}\n\nif (logs < 1) {\n  const spots = [\n    [5, 67, -36],\n    [5, 67, -38],\n    [4, 67, -37],\n    [6, 67, -37],\n    [5, 66, -36],\n    [5, 66, -38],\n    [4, 66, -37],\n    [6, 66, -37]\n  ];\n  for (const spot of spots) {\n    if (logs >= 1) break;\n    const moved = mc.move_to(spot[0], spot[1], spot[2], 15000);\n    console.log('move_to ' + spot.join(',') + ': ' + JSON.stringify(moved));\n    logs = attemptMine();\n  }\n}\n\nconsole.log('final ' + ITEM + ' count: ' + logs);",
