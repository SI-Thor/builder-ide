        "code": "const LOG = 'jungle_log';\nconst TARGET = { x: 5, y: 71, z: -37 };\n\nfunction logCount() {\n  const r = mc.count(LOG);\n  return r && typeof r.count === 'number' ? r.count : 0;\n}\n\nfunction lookAtLog() {\n  mc.look_at(TARGET.x + 0.5, TARGET.y + 0.5, TARGET.z + 0.5);\n  mc.sleep(250);\n}\n\nfunction tryGetLog() {\n  let have = logCount();\n  if (have >= 1) return have;\n\n  lookAtLog();\n\n  for (let i = 0; i < 32 && logCount() < 1; i++) {\n    const m = mc.mine_block(LOG, 64, 1);\n    console.log('mine: ' + JSON.stringify(m));\n    mc.sleep(250);\n  }\n\n  for (let i = 0; i < 32 && logCount() < 1; i++) {\n    const c = mc.collect(LOG, 1, 64);\n    console.log('collect: ' + JSON.stringify(c));\n    mc.sleep(250);\n  }\n\n  return logCount();\n}\n\nlet have = logCount();\nconsole.log('start ' + LOG + ': ' + have);\n\nif (have < 1) {\n  const m = mc.move_to_block(LOG, 64, 60000);\n  console.log('move_to_block: ' + JSON.stringify(m));\n  have = tryGetLog();\n}\n\nif (have < 1) {\n  const spots = [\n    [6, 71, -37],\n    [4, 71, -37],\n    [5, 71, -36],\n    [5, 71, -38],\n    [6, 71, -36],\n    [4, 71, -36],\n    [6, 71, -38],\n    [4, 71, -38],\n    [5, 72, -37],\n    [5, 70, -37]\n  ];\n\n  for (const s of spots) {\n    if (have >= 1) break;\n    const m = mc.move_to(s[0], s[1], s[2], 20000);\n    console.log('move_to ' + s.join(',') + ': ' + JSON.stringify(m));\n    have = tryGetLog();\n  }\n}\n\nif (have < 1) {\n  const m = mc.move_to(TARGET.x + 1, TARGET.y, TARGET.z, 30000);\n  console.log('fallback move: ' + JSON.stringify(m));\n  have = tryGetLog();\n}\n\nconsole.log('final ' + LOG + ': ' + have);\n",
        "description": "Move to the jungle log at (5, 71, -37), look at its center, mine it by hand, and collect the dropped log.",
