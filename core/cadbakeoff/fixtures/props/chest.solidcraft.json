     ],
     "z": [
      1,
      0,
      0
     ]
    },
    "b": {
     "occurrence": "chest_lid",
     "point": [
      0,
      200,
      400
     ],
     "z": [
      1,
      0,
      0
     ]
    },
    "limits": [
     [
      0,
      90
     ]
    ],
    "flip": true,
    "name": "lid_hinge"
   }
  },
  {
   "command": "file.export",
   "params": {
    "path": "robot.urdf",
    "format": "urdf"
   }
  },
  {
   "command": "file.export",
   "params": {
    "path": "prop.step",
    "format": "step"
   }
  }
 ]
}