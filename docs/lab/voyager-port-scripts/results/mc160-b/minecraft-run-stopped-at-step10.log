        "code": "const LOG = 'jungle_log';\nconst TARGET = { x: 11, y: 69, z: -48 };\n\nfunction countLogs() {\n  const r = mc.count(LOG);\n  return r && typeof r.count === 'number' ? r.count : 0;\n}\n\nfunction tryMineAndCollect(maxDistance, mineTries, collectTries) {\n  mc.look_at(TARGET.x + 0.5, TARGET.y + 0.5, TARGET.z + 0.5);\n  mc.sleep(200);\n\n  for (let i = 0; i < mineTries && countLogs() < 1; i++) {\n    const m = mc.mine_block(LOG, maxDistance, 1);\n    console.log('mine: ' + JSON.stringify(m));\n    mc.sleep(300);\n  }\n\n  for (let i = 0; i < collectTries && countLogs() < 1; i++) {\n    const c = mc.collect(LOG, 1, maxDistance);\n    console.log('collect: ' + JSON.stringify(c));\n    mc.sleep(250);\n  }\n\n  return countLogs();\n}\n\nlet n = countLogs();\nconsole.log('start ' + LOG + ': ' + n);\n\nif (n < 1) {\n  const mv = mc.move_to_block(LOG, 16, 30000);\n  console.log('move_to_block: ' + JSON.stringify(mv));\n  n = tryMineAndCollect(16, 10, 10);\n}\n\nif (n < 1) {\n  const mv = mc.move_to(TARGET.x + 0.5, TARGET.y + 0.5, TARGET.z + 0.5, 30000);\n  console.log('move_to: ' + JSON.stringify(mv));\n  n = tryMineAndCollect(16, 12, 12);\n}\n\nif (n < 1) {\n  const spots = [\n    [12, 69, -48],\n    [10, 69, -48],\n    [11, 69, -47],\n    [11, 69, -49],\n    [12, 69, -47],\n    [10, 69, -47],\n    [11, 69, -46],\n    [11, 69, -50]\n  ];\n  for (const s of spots) {\n    if (n >= 1) break;\n    const mv = mc.move_to(s[0] + 0.5, s[1] + 0.5, s[2] + 0.5, 15000);\n    console.log('move_to ' + s.join(',') + ': ' + JSON.stringify(mv));\n    n = tryMineAndCollect(8, 8, 8);\n  }\n}\n\nconsole.log('final ' + LOG + ': ' + n);",
