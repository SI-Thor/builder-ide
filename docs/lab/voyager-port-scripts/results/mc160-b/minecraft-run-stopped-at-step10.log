        "code": "const BLOCK = 'jungle_log';\nconst ITEM = 'jungle_log';\nconst target = { x: 12, y: 69, z: -43 };\n\nfunction countLogs() {\n  const c = mc.count(ITEM);\n  return c && typeof c.count === 'number' ? c.count : 0;\n}\n\nfunction tryMine() {\n  mc.look_at(target.x + 0.5, target.y + 0.5, target.z + 0.5);\n  mc.sleep(250);\n  const mined = mc.mine_block(BLOCK, 16, 1);\n  console.log('mine_block: ' + JSON.stringify(mined));\n  mc.sleep(500);\n  const collected = mc.collect(ITEM, 1, 16);\n  console.log('collect: ' + JSON.stringify(collected));\n  return countLogs();\n}\n\nlet logs = countLogs();\nconsole.log('initial jungle_log count: ' + logs);\n\nif (logs < 1) {\n  const moved = mc.move_to_block(BLOCK, 16, 30000);\n  console.log('move_to_block: ' + JSON.stringify(moved));\n  mc.sleep(250);\n  logs = tryMine();\n}\n\nif (logs < 1) {\n  const near = mc.move_to(target.x + 0.5, target.y + 1, target.z + 0.5, 15000);\n  console.log('move_to: ' + JSON.stringify(near));\n  mc.sleep(250);\n  logs = tryMine();\n}\n\nif (logs < 1) {\n  const side = mc.move_to(target.x + 1.5, target.y + 1, target.z + 0.5, 15000);\n  console.log('move_to side: ' + JSON.stringify(side));\n  mc.sleep(250);\n  logs = tryMine();\n}\n\nconsole.log('final jungle_log count: ' + logs);",
