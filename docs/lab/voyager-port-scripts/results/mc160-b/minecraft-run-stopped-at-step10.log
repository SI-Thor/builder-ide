        "code": "const ITEM = 'jungle_log';\nconst BLOCK = 'jungle_log';\nlet target = { x: 12, y: 69, z: -43 };\n\nconst moved = mc.move_to_block(BLOCK, 16, 30000);\nconsole.log('move_to_block: ' + JSON.stringify(moved));\nif (moved && moved.block && typeof moved.block.x === 'number' && typeof moved.block.y === 'number' && typeof moved.block.z === 'number') {\n  target = { x: moved.block.x, y: moved.block.y, z: moved.block.z };\n}\n\nfunction tryBreakAndCollect() {\n  mc.look_at(target.x + 0.5, target.y + 0.5, target.z + 0.5);\n  mc.sleep(250);\n  const mined = mc.mine_block(BLOCK, 16, 1);\n  console.log('mine_block: ' + JSON.stringify(mined));\n  mc.sleep(500);\n  const collected = mc.collect(ITEM, 1, 16);\n  console.log('collect: ' + JSON.stringify(collected));\n  return collected && typeof collected.collected === 'number' ? collected.collected : 0;\n}\n\nlet got = 0;\nfor (let i = 0; i < 4 && got < 1; i++) {\n  got += tryBreakAndCollect();\n  const count = mc.count(ITEM);\n  if (count && typeof count.count === 'number') {\n    got = count.count;\n  }\n  if (got >= 1) {\n    break;\n  }\n  const near = mc.move_to(target.x + 0.5, target.y + 1, target.z + 0.5, 10000);\n  console.log('move_to: ' + JSON.stringify(near));\n  mc.sleep(250);\n}\n\nconst final = mc.count(ITEM);\nconsole.log('jungle_log count: ' + (final && typeof final.count === 'number' ? final.count : 0));",
