# The worktree's own venv — dependencies are installed here, never system-wide.
.venv/
# The experiment's own torch venv (the DINOv2 probe needs torch; the core
# never does).
.venv-torch/

# Python bytecode
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Tooling caches
.ruff_cache/
.mypy_cache/

# Local service state (the ledger lives under $BUILDER_HOME, but a dev may
# point it at the worktree)
*.db
*.db-wal
*.db-shm
artifacts/
reports/

# Build output
build/
dist/

# The probe's ComfyUI base directory: its logs, pid and scratch are the
# experiment's working state, not source.
docs/lab/trellis-graph-scripts/comfy-base/logs/
docs/lab/trellis-graph-scripts/comfy-base/temp/
docs/lab/trellis-graph-scripts/comfy-base/output/
docs/lab/trellis-graph-scripts/comfy-base/previews/
docs/lab/trellis-graph-scripts/comfy-base/input/
docs/lab/trellis-graph-scripts/comfy-base/user/
docs/lab/trellis-graph-scripts/comfy-base/datasets/
docs/lab/trellis-graph-scripts/comfy-base/models/

# The critic seat's derived images and probed geometry are caches, not
# sources: the recipe is the source of truth.
core/critic/.cache/

# The bake-off's run logs: the noisy tail of a run, not the numbers.
docs/lab/critic-select-scripts/results/*.log

# The delegate bake-off's runtime state and its derived frames. The port the
# admission daemon handed back and the pid in front of the server are the
# running box's state, not the experiment's; the edited frames are derived
# images, the same kind of cache as the set's own (the recipe and the script
# are the source of truth, and the numbers are in the JSONs beside them).
docs/lab/critic-delegate-scripts/results/d1.port
docs/lab/critic-delegate-scripts/results/d1.pid
docs/lab/critic-delegate-scripts/results/*-edited.png
