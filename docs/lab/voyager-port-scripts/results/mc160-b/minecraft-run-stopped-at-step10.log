      "proposal": {
        "code": "const LOG_BLOCK = 'jungle_log';\nconst LOG_ITEM = 'jungle_log';\nconst TARGET = { x: 11, y: 67, z: -35 };\n\nfunction logCount() {\n  const r = mc.count(LOG_ITEM);\n  return r && typeof r.count === 'number' ? r.count : 0;\n}\n\nfunction tryMineAndCollect() {\n  mc.look_at(TARGET.x + 0.5, TARGET.y + 0.5, TARGET.z + 0.5);\n  mc.sleep(200);\n\n  let mined = 0;\n  for (let i = 0; i < 5 && mined < 1; i++) {\n    const m = mc.mine_block(LOG_BLOCK, 64, 1);\n    console.log('mine_block: ' + JSON.stringify(m));\n    if (m && typeof m.mined === 'number') mined += m.mined;\n    mc.sleep(300);\n  }\n\n  let collected = 0;\n  for (let i = 0; i < 5 && collected < 1; i++) {\n    const c = mc.collect(LOG_ITEM, 1, 64);\n    console.log('collect: ' + JSON.stringify(c));\n    if (c && typeof c.collected === 'number') collected += c.collected;\n    mc.sleep(300);\n  }\n\n  return logCount();\n}\n\nlet have = logCount();\nconsole.log('initial ' + LOG_ITEM + ': ' + have);\n\nif (have < 1) {\n  const moved = mc.move_to_block(LOG_BLOCK, 32, 30000);\n  console.log('move_to_block: ' + JSON.stringify(moved));\n  have = tryMineAndCollect();\n}\n\nif (have < 1) {\n  const spots = [\n    [10, 66, -35],\n    [12, 66, -35],\n    [11, 66, -34],\n    [11, 66, -36],\n    [10, 66, -34],\n    [12, 66, -34],\n    [10, 66, -36],\n    [12, 66, -36]\n  ];\n\n  for (const spot of spots) {\n    if (have >= 1) break;\n    const moved = mc.move_to(spot[0], spot[1], spot[2], 15000);\n    console.log('move_to ' + spot.join(',') + ': ' + JSON.stringify(moved));\n    have = tryMineAndCollect();\n  }\n}\n\nconsole.log('final ' + LOG_ITEM + ': ' + have);",
