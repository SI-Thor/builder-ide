      "proposal": {
        "code": "const LOG = 'jungle_log';\nconst TARGET = { x: 5, y: 70, z: -37 };\n\nfunction haveLog() {\n  const r = mc.count(LOG);\n  return r && typeof r.count === 'number' ? r.count : 0;\n}\n\nfunction tryMine() {\n  mc.look_at(TARGET.x + 0.5, TARGET.y + 0.5, TARGET.z + 0.5);\n  mc.sleep(250);\n\n  let mined = 0;\n  for (let i = 0; i < 24 && mined < 1; i++) {\n    const m = mc.mine_block(LOG, 64, 1);\n    console.log('mine: ' + JSON.stringify(m));\n    if (m && typeof m.mined === 'number') mined += m.mined;\n    mc.sleep(200);\n  }\n\n  let collected = 0;\n  for (let i = 0; i < 24 && collected < 1; i++) {\n    const c = mc.collect(LOG, 1, 64);\n    console.log('collect: ' + JSON.stringify(c));\n    if (c && typeof c.collected === 'number') collected += c.collected;\n    mc.sleep(200);\n  }\n\n  return haveLog();\n}\n\nlet have = haveLog();\nconsole.log('start ' + LOG + ': ' + have);\n\nif (have < 1) {\n  const m = mc.move_to_block(LOG, 64, 45000);\n  console.log('move_to_block: ' + JSON.stringify(m));\n  have = tryMine();\n}\n\nif (have < 1) {\n  const spots = [\n    [5, 70, -36],\n    [5, 70, -38],\n    [4, 70, -37],\n    [6, 70, -37],\n    [5, 69, -36],\n    [5, 69, -38],\n    [4, 69, -37],\n    [6, 69, -37],\n    [5, 71, -37],\n    [5, 70, -35],\n    [5, 70, -39],\n    [4, 70, -36],\n    [6, 70, -36],\n    [4, 70, -38],\n    [6, 70, -38],\n    [5, 69, -35],\n    [5, 69, -39],\n    [5, 71, -36],\n    [5, 71, -38],\n    [4, 71, -37],\n    [6, 71, -37]\n  ];\n\n  for (const s of spots) {\n    if (have >= 1) break;\n    const m = mc.move_to(s[0], s[1], s[2], 15000);\n    console.log('move_to ' + s.join(',') + ': ' + JSON.stringify(m));\n    have = tryMine();\n  }\n}\n\nif (have < 1) {\n  const m = mc.move_to(TARGET.x, TARGET.y, TARGET.z, 45000);\n  console.log('move_to target: ' + JSON.stringify(m));\n  have = tryMine();\n}\n\nconsole.log('final ' + LOG + ': ' + have);\n",
