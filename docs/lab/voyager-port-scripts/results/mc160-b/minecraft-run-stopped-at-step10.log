        "code": "const ITEM = 'oak_log';\nconst TARGET = { x: 1, y: 70, z: -39 };\n\nfunction have() {\n  const r = mc.count(ITEM);\n  return r && typeof r.count === 'number' ? r.count : 0;\n}\n\nfunction tryMineCollect(maxDistance, tries) {\n  for (let i = 0; i < tries && have() < 1; i++) {\n    const m = mc.mine_block(ITEM, maxDistance, 1);\n    console.log('mine: ' + JSON.stringify(m));\n    mc.sleep(300);\n    const c = mc.collect(ITEM, 1, maxDistance);\n    console.log('collect: ' + JSON.stringify(c));\n    mc.sleep(250);\n  }\n  return have();\n}\n\nlet n = have();\nconsole.log('start ' + ITEM + ': ' + n);\n\nif (n < 1) {\n  const mv = mc.move_to_block(ITEM, 32, 30000);\n  console.log('move_to_block: ' + JSON.stringify(mv));\n  const bx = mv && mv.block && typeof mv.block.x === 'number' ? mv.block.x : TARGET.x;\n  const by = mv && mv.block && typeof mv.block.y === 'number' ? mv.block.y : TARGET.y;\n  const bz = mv && mv.block && typeof mv.block.z === 'number' ? mv.block.z : TARGET.z;\n  mc.look_at(bx + 0.5, by + 0.5, bz + 0.5);\n  mc.sleep(200);\n  n = tryMineCollect(32, 6);\n}\n\nif (n < 1) {\n  const spots = [\n    { x: TARGET.x + 1.5, y: TARGET.y + 0.5, z: TARGET.z + 0.5 },\n    { x: TARGET.x - 1.5, y: TARGET.y + 0.5, z: TARGET.z + 0.5 },\n    { x: TARGET.x + 0.5, y: TARGET.y + 0.5, z: TARGET.z + 1.5 },\n    { x: TARGET.x + 0.5, y: TARGET.y + 0.5, z: TARGET.z - 1.5 }\n  ];\n  for (const s of spots) {\n    if (have() >= 1) break;\n    const mv = mc.move_to(s.x, s.y, s.z, 20000);\n    console.log('move_to: ' + JSON.stringify(mv));\n    mc.look_at(TARGET.x + 0.5, TARGET.y + 0.5, TARGET.z + 0.5);\n    mc.sleep(200);\n    n = tryMineCollect(32, 4);\n  }\n}\n\nconsole.log('final ' + ITEM + ': ' + n);",
